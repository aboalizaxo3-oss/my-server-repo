APP_NAME=Kawar Copart Server
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=*
# Set this only to a public Copart listing/search URL you are allowed to access.
COPART_SEARCH_URL=
FETCH_INTERVAL_MINUTES=15
HTTP_USER_AGENT=KawarAuctionMonitor/1.0
# Optional SMTP settings; keep secrets in Render, never in HTML or Git.
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
